NODE_ENV=development
PORT=4000

# PostgreSQL connection string for local instance
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flightpath?schema=public"

# JWT Secrets
JWT_SECRET="flightpath-development-super-secret-key-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="flightpath-development-refresh-secret-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Default SuperAdmin Initial Credentials
SUPERADMIN_EMAIL="admin@flightpath.aero"
SUPERADMIN_PASSWORD="Flightpath@2026!"
